# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Obsidian runtime
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/graph.json.bak
vault/.obsidian/cache/

# Local notes and assignment projects (not published)
/vault/Лекции/*
!/vault/Лекции/.gitkeep
!/vault/Лекции/Лекторий.md
!/vault/Лекции/Лекторий/
!/vault/Лекции/Лекторий/**
/vault/Задания/*
!/vault/Задания/.gitkeep
!/vault/Задания/01 — Сохранить первую лекцию.md
!/vault/Задания/02 — Написать greet.md
!/vault/Задания/03 — Прочитать example.com.md
/vault/Вложения/*
!/vault/Вложения/.gitkeep
/vault/00 Главная.md
/vault/Карта курса.md
/code/*
!/code/.gitkeep
!/code/01-sohranit-pervuyu-lekciyu/
!/code/01-sohranit-pervuyu-lekciyu/**
!/code/02-napisat-greet/
!/code/02-napisat-greet/**
!/code/03-prochitat-example-com/
!/code/03-prochitat-example-com/**

